---
import '../styles/tokens.css';
import '../styles/motion.css';
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmojiBackground from '../components/EmojiBackground.astro';
import { withBase } from '../lib/paths.js';
const { title = 'The Rookie Explorers', ambientEmoji = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={withBase('/favicon.svg')} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body>
    {ambientEmoji && <EmojiBackground />}
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/scroll-reveal.js';
    </script>
  </body>
</html>
