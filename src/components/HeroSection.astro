---
import { getPhotos } from '../lib/photos.js';
const photos = getPhotos('hero');
---
<section class="hero" data-animate="fade-up">
  <div class="hero-photos">
    {photos.length > 0
      ? photos.slice(0, 4).map((src) => <img src={src} alt="" loading="eager" />)
      : <div class="hero-fallback"></div>}
  </div>
  <div class="hero-scrim"></div>
  <div class="hero-copy">
    <h1>The Rookie <span class="accent">Explorers</span></h1>
    <p>You don't need to be rich to see the world.</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 85vh;
    padding: var(--space-section) var(--space-xl);
    text-align: center;
    overflow: hidden;
  }
  .hero-fallback {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--color-surface-soft), var(--color-primary-disabled));
    z-index: -2;
  }
  .hero-photos {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    z-index: -2;
    opacity: 0.85;
    background: linear-gradient(135deg, var(--color-surface-soft), var(--color-primary-disabled));
  }
  .hero-photos img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(20, 14, 12, 0.35);
  }
  .hero-copy {
    position: relative;
    z-index: 1;
  }
  .hero-copy h1 {
    font-size: 40px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 var(--space-sm);
  }
  .hero-copy h1 .accent {
    color: var(--color-primary);
  }
  .hero-copy p {
    font-size: 22px;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
  }
  @media (max-width: 744px) {
    .hero {
      min-height: 70vh;
    }
    .hero-photos {
      grid-template-columns: repeat(2, 1fr);
    }
    .hero-copy h1 {
      font-size: 30px;
    }
  }
</style>
