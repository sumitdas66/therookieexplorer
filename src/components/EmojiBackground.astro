---
const EMOJI = ['✈️', '🧳', '🗺️', '🏖️', '🎒', '🌏', '🚆', '🏔️', '📸', '🌴', '🧭', '🏝️', '🚗', '⛺', '🎡', '🚌', '🛶', '🌅'];
const COUNT = 18;
const items = Array.from({ length: COUNT }, (_, i) => {
  const emoji = EMOJI[i % EMOJI.length];
  const left = Math.round((i / COUNT) * 100 + (i % 3) * 2);
  const delay = (i * 1.1).toFixed(1);
  const duration = (16 + (i % 5) * 3).toFixed(1);
  const size = 22 + (i % 3) * 6;
  return { emoji, left, delay, duration, size };
});
---
<div class="emoji-layer" aria-hidden="true">
  {items.map((item) => (
    <span
      class="emoji"
      style={`left: ${item.left}%; font-size: ${item.size}px; animation-delay: ${item.delay}s; animation-duration: ${item.duration}s;`}
    >
      {item.emoji}
    </span>
  ))}
</div>

<style>
  .emoji-layer {
    position: fixed;
    inset: 0;
    height: 100vh;
    overflow: hidden;
    pointer-events: none;
    z-index: 2;
  }
  .emoji {
    position: absolute;
    top: 100%;
    opacity: 0.4;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.15));
    animation-name: float-up;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform;
  }
  @keyframes float-up {
    from { transform: translateY(0); }
    to { transform: translateY(-120vh); }
  }
  @media (prefers-reduced-motion: reduce) {
    .emoji-layer {
      display: none;
    }
  }
</style>
